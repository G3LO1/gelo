# Copy to .env in the game folder and fill in. Keep .env out of git (add it to .gitignore).
# Open Cloud API key: Creator Hub > All tools > Open Cloud > API Keys.
# Permissions: assets read + write; asset-permissions write (only for `bringforth.py grant`);
# game-passes + developer-products read + write if the same key is used by roblox-monetization.
ROBLOX_API_KEY=

# Who owns uploaded assets: set ONE of them to the owner of the game (default: the key's owner).
ROBLOX_CREATOR_GROUP_ID=
ROBLOX_CREATOR_USER_ID=
